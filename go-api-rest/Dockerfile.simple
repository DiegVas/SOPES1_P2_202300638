# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copiar go.mod y descargar dependencias
COPY go.mod go.sum ./
RUN go mod download

# Copiar código fuente
COPY . .

# Compilar
RUN CGO_ENABLED=0 GOOS=linux go build -o go-api-rest main.go

# Runtime stage
FROM alpine:latest

WORKDIR /root/

RUN apk --no-cache add ca-certificates

COPY --from=builder /app/go-api-rest .

EXPOSE 8080

CMD ["./go-api-rest"]
